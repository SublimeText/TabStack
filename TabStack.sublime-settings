{
  // Path to the `tabstack-keystate` helper that detects Ctrl releases on Linux.
  // It is used whenever it works, and it is required under native Wayland.
  "keystate_helper_path": "/usr/local/libexec/tabstack-keystate",

  // Offer the helper's setup instructions on the first Ctrl+Tab per plugin load
  // when Ctrl-release detection is unavailable under native Wayland.
  "show_wayland_setup_dialog": true,
}
